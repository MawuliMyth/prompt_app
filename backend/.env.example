# Server Configuration
PORT=3001
NODE_ENV=development

# API Keys
GROQ_API_KEY=your_groq_api_key
CLAUDE_API_KEY=your_claude_api_key

# Firebase Admin (pick one approach)
# Option 1: full JSON blob on one line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"prompt-5a926","private_key":"-----BEGIN PRIVATE KEY-----\nPASTE_NEW_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-fbsvc@prompt-5a926.iam.gserviceaccount.com"}

# Option 2: individual service account fields
FIREBASE_PROJECT_ID=prompt-5a926
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@prompt-5a926.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Guest usage hashing salt - required outside local development (the app
# refuses to start hashing guest IPs without it unless NODE_ENV=development
# or NODE_ENV=test). Generate a real random value, e.g. `openssl rand -hex 32`.
GUEST_USAGE_SALT=REPLACE_WITH_RANDOM_64_HEX_CHARS

# Comma-separated list of Firebase Auth emails allowed to read/write the
# system prompts editor at /system-prompts (see accessControl.js#requireAdmin).
ADMIN_EMAILS=admin@example.com

# Only set this if this server sits behind a reverse proxy/load balancer you
# control (e.g. '1' for one trusted hop, or 'loopback'). Leave unset unless
# you have one - trusting X-Forwarded-For without a real proxy in front lets
# any caller spoof their IP and bypass rate limiting/guest quotas.
# TRUST_PROXY=1

# URLs (for CORS) - Set this to your production frontend URL when deploying
FRONTEND_URL=http://localhost:5000
